meta {
  name: Listar clientes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/clientes
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  test("deve retornar 200 e JSON", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.contain("application/json");
  });

  test("deve retornar uma lista de clientes", function () {
    const body = res.getBody();
    expect(body).to.be.an("array");
    body.forEach((cliente) => {
      expect(cliente).to.have.all.keys(
        "id",
        "nome",
        "email",
        "vip",
        "corporativo",
        "bloqueado",
        "dataCadastro"
      );
      expect(cliente.id).to.be.a("string").and.not.be.empty;
      expect(cliente.email).to.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/);
      expect(cliente.vip).to.be.a("boolean");
    });
  });
}

docs {
  Lista todos os clientes em ordem de nome.

  Requer apenas `baseUrl`.

  Esperado: `200` com um array de clientes contendo `id`, `nome`, `email`, `vip`, `corporativo`, `bloqueado` e `dataCadastro`.
}
