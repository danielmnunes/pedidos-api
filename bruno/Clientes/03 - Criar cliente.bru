meta {
  name: Criar cliente
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/clientes
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "nome": "Cliente de teste",
    "email": "cliente.teste.{{$timestamp}}@exemplo.com",
    "vip": false,
    "corporativo": false,
    "bloqueado": false
  }
}

script:post-response {
  test("deve retornar 201 com Location", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("location")).to.match(/^\/clientes\/[0-9a-f-]{36}$/);
  });

  test("deve retornar o cliente criado", function () {
    const body = res.getBody();
    expect(body).to.have.all.keys(
      "id",
      "nome",
      "email",
      "vip",
      "corporativo",
      "bloqueado",
      "dataCadastro"
    );
    expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);
    expect(body.nome).to.equal("Cliente de teste");
    expect(body.email).to.match(/^cliente\.teste\.\d+@exemplo\.com$/);
    expect(body.vip).to.equal(false);
    expect(body.corporativo).to.equal(false);
    expect(body.bloqueado).to.equal(false);
    expect(body.dataCadastro).to.be.a("string").and.not.be.empty;
  });

  test("deve guardar os dados do cliente para as próximas requisições", function () {
    const body = res.getBody();
    bru.setVar("clienteCriadoId", body.id);
    bru.setVar("clienteCriadoEmail", body.email);
    bru.setVar("clienteCriadoDataCadastro", body.dataCadastro);
  });
}

docs {
  Cria um cliente sem `id` e sem `dataCadastro`: a API gera ambos.

  O e-mail usa `{{$timestamp}}` para não conflitar com execuções anteriores.

  Esperado: `201`, cabeçalho `Location: /clientes/{id}` e o cliente criado.

  Efeito colateral: grava `clienteCriadoId`, `clienteCriadoEmail` e `clienteCriadoDataCadastro` para as requisições seguintes.
}
