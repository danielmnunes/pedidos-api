meta {
  name: Criar cliente com e-mail duplicado
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/clientes
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "nome": "Cliente duplicado",
    "email": "{{clienteCriadoEmail}}"
  }
}

script:post-response {
  test("deve retornar 409 em application/problem+json", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
  });

  test("deve descrever o conflito", function () {
    const body = res.getBody();
    expect(body.status).to.equal(409);
    expect(body.detail).to.equal("Já existe um registro com esses dados");
    expect(body.instance).to.equal("/clientes");
  });
}

docs {
  Tenta criar outro cliente com o e-mail de `03 - Criar cliente`.

  Dependência: rode `03 - Criar cliente` antes para preencher `clienteCriadoEmail`, e rode esta requisição antes de `06 - Excluir cliente`.

  Esperado: `409` com `application/problem+json` e `detail` igual a "Já existe um registro com esses dados".
}
