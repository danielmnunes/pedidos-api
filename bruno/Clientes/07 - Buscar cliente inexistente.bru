meta {
  name: Buscar cliente inexistente
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/clientes/:id
  body: none
  auth: none
}

params:path {
  id: {{clienteInexistenteId}}
}

headers {
  Accept: application/json
}

script:post-response {
  test("deve retornar 404 em application/problem+json", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
  });

  test("deve descrever o problema", function () {
    const body = res.getBody();
    expect(body.status).to.equal(404);
    expect(body.detail).to.equal("Cliente não encontrado");
    expect(body.instance).to.equal("/clientes/" + bru.getEnvVar("clienteInexistenteId"));
  });
}

docs {
  Busca um id que não existe (`clienteInexistenteId`).

  Esperado: `404` com RFC 9457, `detail` igual a "Cliente não encontrado" e `instance` com o caminho consultado.
}
