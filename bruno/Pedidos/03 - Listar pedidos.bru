meta {
  name: Listar pedidos
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/pedidos
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  test("deve retornar 200 e JSON", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.contain("application/json");
  });

  test("deve retornar uma lista de pedidos", function () {
    const body = res.getBody();
    expect(body).to.be.an("array");
    body.forEach((pedido) => {
      expect(pedido).to.have.all.keys("id", "cliente", "status", "total", "dataCriacao", "itens");
      expect(pedido.itens).to.be.an("array");
    });
  });

  test("deve incluir o pedido criado na coleção", function () {
    const pedidoId = bru.getVar("pedidoId");
    if (pedidoId) {
      expect(res.getBody().map((pedido) => pedido.id)).to.include(pedidoId);
    }
  });
}

docs {
  Lista todos os pedidos, com o nome do cliente e os itens.

  Esperado: `200` com um array de pedidos. A última verificação só roda se `pedidoId` tiver sido gravado por `01 - Criar pedido VIP`.
}
