meta {
  name: Criar pedido com produto inexistente
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/pedidos
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "clienteId": "{{clienteId}}",
    "itens": [
      { "produtoId": "{{produtoInexistenteId}}", "quantidade": 1 }
    ]
  }
}

script:post-response {
  test("deve retornar 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("deve informar qual produto não foi encontrado", function () {
    expect(res.getBody()).to.equal(
      "Produto " + bru.getEnvVar("produtoInexistenteId") + " não encontrado."
    );
  });
}

docs {
  Envia um item com `produtoId` inexistente.

  Esperado: `400` com o texto "Produto {id} não encontrado." e nenhum pedido gravado (a operação é transacional).
}
