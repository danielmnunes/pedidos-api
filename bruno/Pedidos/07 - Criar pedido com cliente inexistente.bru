meta {
  name: Criar pedido com cliente inexistente
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/pedidos
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "clienteId": "{{clienteInexistenteId}}",
    "itens": [
      { "produtoId": "{{produtoId}}", "quantidade": 1 }
    ]
  }
}

script:post-response {
  test("deve retornar 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("deve explicar que o cliente não foi encontrado", function () {
    expect(res.getBody()).to.equal("Cliente não encontrado.");
  });
}

docs {
  Envia um `clienteId` que não existe.

  Esperado: `400` com o texto "Cliente não encontrado.".
}
