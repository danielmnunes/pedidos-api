meta {
  name: Atualizar produto
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/produtos/:id
  body: json
  auth: none
}

params:path {
  id: {{produtoCriadoId}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "nome": "Produto de teste (atualizado)",
    "categoria": "Teste",
    "preco": 149.90,
    "estoque": 5
  }
}

script:post-response {
  test("deve retornar 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("deve devolver o produto com os dados atualizados", function () {
    const body = res.getBody();
    expect(body.id).to.equal(bru.getVar("produtoCriadoId"));
    expect(body.nome).to.equal("Produto de teste (atualizado)");
    expect(body.preco).to.equal(149.9);
    expect(body.estoque).to.equal(5);
  });
}

docs {
  Atualiza o produto criado em `03 - Criar produto`.

  Dependência: rode `03 - Criar produto` antes; sem `produtoCriadoId` a API responde `404`.

  Esperado: `200` com preço `149.90` e estoque `5`.
}
