meta {
  name: Buscar produto inexistente
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/produtos/:id
  body: none
  auth: none
}

params:path {
  id: {{produtoInexistenteId}}
}

headers {
  Accept: application/json
}

script:post-response {
  test("deve retornar 404 em application/problem+json", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
  });

  test("deve descrever o problema", function () {
    const body = res.getBody();
    expect(body.status).to.equal(404);
    expect(body.detail).to.equal("Produto não encontrado");
    expect(body.instance).to.equal("/produtos/" + bru.getEnvVar("produtoInexistenteId"));
  });
}

docs {
  Busca um id que não existe (`produtoInexistenteId`).

  Esperado: `404` com RFC 9457 e `detail` igual a "Produto não encontrado".
}
